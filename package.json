    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.30.0",
    "eslint-config-next": "15.5.29",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.5",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "3.2.7"

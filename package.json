    "@xyflow/react": "12.12.1",
    "bcryptjs": "3.0.3",
    "lucide-react": "0.577.0",
    "next": "15.5.29",
    "next-auth": "4.24.15",
    "papaparse": "^5.5.3",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "recharts": "^3.2.1",
    "server-only": "0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3.3.1",

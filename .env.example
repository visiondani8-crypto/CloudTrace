# LOCAL DEVELOPMENT ONLY — REPLACE AUTH_SECRET AND DEMO PASSWORD BEFORE USE.
# Copy to .env:  cp .env.example .env
DATABASE_URL="file:./dev.db"

# Session signing secret (min. 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="replace-with-a-long-random-secret-before-running"

# Base URL used by the authentication library for callbacks.
NEXTAUTH_URL="http://localhost:3000"

# Password given to the seeded demo accounts (min. 12 characters).
# The seed refuses to run with this placeholder value.
DEMO_SEED_PASSWORD="replace-this-with-a-unique-local-dev-password"

NEXT_PUBLIC_APP_NAME="CloudTrace"

# OPTIONAL — the application must function without these.
# Claude analysis (server-side only). CLAUDE_MODEL defaults to claude-opus-5-5 when empty.
ANTHROPIC_API_KEY=""
CLAUDE_MODEL=""

# Microsoft 365 service health connector (read-only, app-only, ServiceHealth.Read.All).
MS_TENANT_ID=""
MS_CLIENT_ID=""
MS_CLIENT_SECRET=""
# The connector serves exactly one explicitly selected workspace (organisation slug),
# e.g. "northstar-demo". Leave empty to keep the connector unassigned.
MS_CONNECTOR_ORGANIZATION_SLUG=""

# Allows organisation owners to create local demo users from Settings.
# Always disabled when NODE_ENV=production unless explicitly set to "true".
ALLOW_DEMO_USER_CREATION="true"
